# ==========================================
# Student Score Data Analysis
# ==========================================

import pandas as pd
import matplotlib.pyplot as plt


# Step 1: Load the dataset
# The dataset is stored inside the data folder.
df = pd.read_csv("../data/student_scores.csv")


# Step 2: Display the first five records
print("First 5 Records:")
print(df.head())


# Step 3: Display basic information
print("\nDataset Information:")
print(df.info())


# Step 4: Check for missing values
print("\nMissing Values:")
print(df.isnull().sum())


# Step 5: Calculate basic statistics
print("\nStatistical Summary:")
print(df.describe())


# Step 6: Calculate average score
average_score = df["Score"].mean()

print("\nAverage Score:", round(average_score, 2))


# Step 7: Create a scatter plot
plt.figure(figsize=(7, 5))

plt.scatter(
    df["Hours_Studied"],
    df["Score"]
)

plt.title("Hours Studied vs Score")
plt.xlabel("Hours Studied")
plt.ylabel("Score")
plt.grid(True)

plt.show()


# Step 8: Save cleaned data
df.to_csv("../outputs/result.csv", index=False)

print("\nResult saved successfully!")
