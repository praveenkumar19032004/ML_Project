import matplotlib.pyplot as plt

# Sample Data
months = ["Jan", "Feb", "Mar", "Apr", "May"]
sales = [1200, 1500, 1800, 1700, 2000]
expenses = [800, 900, 1100, 1000, 1200]

# Scatter Plot
plt.figure(figsize=(6,4))
plt.scatter(sales, expenses, color="purple")
plt.title("Sales vs Expenses")
plt.xlabel("Sales")
plt.ylabel("Expenses")
plt.grid(True)
plt.show()

# Bar Chart
plt.figure(figsize=(6,4))
plt.bar(months, sales, color="orange")
plt.title("Monthly Sales")
plt.xlabel("Months")
plt.ylabel("Sales")
plt.show()

# Line Chart
plt.figure(figsize=(6,4))
plt.plot(months, expenses, marker="o", linewidth=2)
plt.title("Monthly Expenses")
plt.xlabel("Months")
plt.ylabel("Expenses")
plt.grid(True)
plt.show()
